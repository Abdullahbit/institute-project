# API — copy to .env (never commit .env)
PORT=4000
NODE_ENV=development

# Supabase (service_role — API only, never frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Dev fallback when Supabase is not configured
DEV_SCHOOL_ID=a0000000-0000-4000-8000-000000000001

# Upstash Redis
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Optional: Anthropic for AIService
ANTHROPIC_API_KEY=
